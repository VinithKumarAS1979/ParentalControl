{
  "manifest_version": 3,
  "name": "ParentalControl Website Blocker",
  "version": "1.0.0",
  "description": "Blocks domains and URL fragments from the local ParentalControl block list and shows a browser block page.",
  "permissions": ["alarms", "declarativeNetRequest", "storage"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ParentalControl Blocker"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
